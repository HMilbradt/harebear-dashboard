{
  "name": "harebear-dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "A self-hosted start page and homelab dashboard. YAML config, live reload, typed widget plugins, built on harebear-ui.",
  "license": "MIT",
  "author": "Harrison Milbradt",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HMilbradt/harebear-dashboard.git"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && node scripts/build-cli.mjs",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "esbuild": "0.28.2",
    "fast-xml-parser": "^5.12.0",
    "harebear-ui": "^0.7.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "srvx": "^1.0.8",
    "tailwindcss": "^4.3.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "bin": {
    "harebear-dashboard": "dist/cli.mjs"
  }
}
